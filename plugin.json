{
	"id": "screenRecorder",
	"name": "Screen Recorder",
	"description": "Start, stop, and configure screen captures with gpu-screen-recorder on any Wayland compositor",
	"version": "1.4.0",
	"author": "arqueon",
	"icon": "videocam",
	"type": "composite",
	"components": {
		"daemon": "./ScreenRecorderService.qml",
		"widget": "./ScreenRecorder.qml"
	},
	"settings": "./Settings.qml",
	"startupCheck": "./StartupCheck.qml",
	"capabilities": ["daemon", "dankbar-widget", "control-center"],
	"dependencies": ["gpu-screen-recorder"],
	"permissions": ["settings_read", "settings_write", "process"],
	"requires_dms": ">=1.2.0"
}
